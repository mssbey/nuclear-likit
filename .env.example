# Nuclear Likit — ortam değişkenleri şablonu. `.env` olarak kopyalayın.

# Bu dağıtımın mağazası. Panel (Mixle) ürünleri/siparişleri bu kimlikle ayırır.
STORE_ID=nuclear

# Mixle ile AYNI veritabanı (Vercel: Storage → Mixle'ın Prisma Postgres deposu → Connect Project).
DATABASE_URL=
# Uzak DB bağlantı kotası iki projede paylaşılır; küçük tutun.
DATABASE_POOL_MAX=3

# Mixle ile AYNI olmalı: ödeme/e-posta anahtarları DB'de bu anahtarla şifreli.
ENCRYPTION_KEY=
# Mixle'dan FARKLI olmalı: müşteri oturumları iki sitede ayrı.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# true: kart ödemesi test (mock) sayfasına gider, e-postalar gönderilmez.
DEMO_MODE=true

# Bu vitrinin adresi (canonical, sitemap, ödeme dönüş adresleri).
NEXT_PUBLIC_SITE_URL=https://nuclearlikit.com
# Görece yollu ürün görselleri (/images/…, /api/medya/…) bu adresten yüklenir.
# Panelden Blob'a yüklenen görseller zaten mutlak URL'dir.
NEXT_PUBLIC_MEDIA_BASE_URL=https://mixle.net

# Panelden önbellek yenileme ve ürün önizlemesi için — Mixle'daki ile AYNI değer.
# Mixle tarafında ayrıca: STOREFRONT_REVALIDATE_URLS=https://nuclearlikit.com/api/yenile
REVALIDATE_SECRET=

# Gece katalog yenileme cron'u (vercel.json) için.
CRON_SECRET=

# Ödeme sağlayıcısı ve e-posta anahtarları panelden (Mixle → mağaza: Nuclear Likit →
# Ayarlar) girilir; bu dağıtım için yedek olarak buraya da yazılabilir:
# IYZICO_API_KEY= / IYZICO_SECRET_KEY= / PAYTR_* / STRIPE_* / SMTP_* / MAIL_FROM= / RESEND_API_KEY=
